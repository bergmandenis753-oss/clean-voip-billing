# Billing web app
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-long-password
API_SECRET_KEY=change-this-long-random-secret
BILLING_DB_PATH=/opt/voip-billing/data/billing.db
PUBLIC_SIP_HOST=YOUR_SERVER_PUBLIC_IP
PORT=8080

# App role: billing/web or bot/telegram
VOIP_APP_ROLE=billing

# Optional public URL. For IP-only testing use http://YOUR_SERVER_PUBLIC_IP:8080
PUBLIC_BASE_URL=http://YOUR_SERVER_PUBLIC_IP:8080

# Low balance alerts
LOW_BALANCE_ALERTS_ENABLED=1
LOW_BALANCE_THRESHOLD_USD=10
LOW_BALANCE_CHECK_SECONDS=300
LOW_BALANCE_ADMIN_ALERTS_ENABLED=1

# Optional Telegram bot service
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
BILLING_API_BASE_URL=http://127.0.0.1:8080
BILLING_API_SECRET_KEY=change-this-long-random-secret
PUBLIC_BOT_BASE_URL=http://YOUR_SERVER_PUBLIC_IP:8081

# Optional AI diagnostics
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional pcap collector defaults
BILLING_API=http://127.0.0.1:8080
BILLING_API_KEY_FILE=/etc/freeswitch/billing_api_key
VOIP_PCAP_IFACE=any
VOIP_LOCAL_IPS=YOUR_SERVER_PUBLIC_IP,YOUR_SERVER_PRIVATE_IP
VOIP_PCAP_FILTER=udp port 5060 or udp port 5080
